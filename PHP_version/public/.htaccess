# Route every request that is not a real file/dir through the front controller.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    RewriteRule ^ index.php [L]
</IfModule>

# Never serve dotfiles.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
